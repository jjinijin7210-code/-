# Supabase 프로젝트 설정 (프론트엔드용 - VITE_ 접두사 필수, 브라우저에 노출되는 값)
# Supabase 대시보드 > Project Settings > API 에서 확인 가능
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ============================================================
# 아래부터는 백엔드(server/) 전용 값이에요. 절대 VITE_ 를 붙이지 마세요.
# VITE_ 가 붙으면 브라우저에 그대로 노출돼서, 다른 사람이 개발자도구로 볼 수 있게 돼요.
# ============================================================

# --- Claude API (콘텐츠 관리 탭의 "AI로 초안 생성" / 자동 검수 기능) ---
ANTHROPIC_API_KEY=sk-ant-여기에-발급받은-키-붙여넣기
# ANTHROPIC_MODEL=claude-sonnet-5   # 선택사항 - 안 넣으면 기본값(claude-sonnet-5) 사용

# --- 백엔드 서버 포트 ---
PORT=3001
# 로컬 개발 환경이 PORT를 프론트엔드 포트(5173)로 미리 설정해두는 경우를 대비한 예비 값 (PORT보다 우선함)
BACKEND_PORT=3001

# --- 구글 Blogger 연동 (지금은 준비 단계 - 실제로 쓰려면 아래 안내대로 발급받아야 해요) ---
# 1. https://console.cloud.google.com 접속 → 새 프로젝트 생성
# 2. "API 및 서비스 > 라이브러리"에서 "Blogger API v3" 검색해서 사용 설정
# 3. "API 및 서비스 > OAuth 동의 화면"에서 앱 이름 등 기본 정보 입력
#    (개인 사용이면 "테스트 사용자"에 본인 구글 계정을 추가해야 로그인이 막히지 않아요)
# 4. "API 및 서비스 > 사용자 인증 정보"에서 "OAuth 클라이언트 ID" 만들기
#    - 애플리케이션 유형: 웹 애플리케이션
#    - 승인된 리디렉션 URI: http://localhost:3001/auth/google/callback
#      (아래 GOOGLE_REDIRECT_URI와 정확히 똑같아야 해요)
# 5. 발급된 클라이언트 ID / 클라이언트 보안 비밀번호를 아래에 붙여넣기
GOOGLE_CLIENT_ID=여기에-클라이언트-ID
GOOGLE_CLIENT_SECRET=여기에-클라이언트-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# 발행할 블로그의 ID (Blogger 관리 화면에서 확인 가능한 숫자, 나중에 채워도 됨)
BLOGGER_BLOG_ID=여기에-블로그ID

# --- 유튜브 인기 영상 검색 (벤치마킹 리포트 탭) ---
# 1. https://console.cloud.google.com 접속 (구글 Blogger용으로 만든 프로젝트 그대로 써도 됨)
# 2. "API 및 서비스 > 라이브러리"에서 "YouTube Data API v3" 검색해서 사용 설정
# 3. "API 및 서비스 > 사용자 인증 정보" > "+ 사용자 인증 정보 만들기" > "API 키" 선택
#    (OAuth 클라이언트 ID 아니고 그냥 "API 키" - 훨씬 간단하고 비밀 값도 없어요)
# 4. 발급된 키를 아래에 붙여넣기 (카드 등록 필요 없음, 하루 무료 할당량 안에서 사용)
YOUTUBE_API_KEY=여기에-API-키

# --- 1688 상품 소싱 검색 (벤치마킹 리포트 탭) ---
# 1. https://console.apify.com 가입 (무료 플랜으로 시작 가능)
# 2. Settings > Integrations 에서 API 토큰 발급
# 3. 발급된 토큰을 아래에 붙여넣기
APIFY_TOKEN=여기에-Apify-API-토큰

# --- 쇼츠 자동 제작 (벤치마킹 리포트 탭 - 상품 검색 결과에서 "쇼츠 만들기") ---
# 1. https://elevenlabs.io 가입 (무료 플랜으로 시작 가능)
# 2. 우측 상단 프로필 > API Keys 에서 발급
# 3. 발급된 키를 아래에 붙여넣기
ELEVENLABS_API_KEY=여기에-ElevenLabs-API-키
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # 선택사항 - 안 넣으면 기본 다국어 음성(Rachel) 사용

# --- AI 이미지 생성 (콘텐츠 관리 탭 - "AI 이미지 생성") ---
# 1. https://platform.openai.com 가입 후 결제수단 등록 (이미지 생성은 종량제)
# 2. API keys 메뉴에서 발급
# 3. 발급된 키를 아래에 붙여넣기
OPENAI_API_KEY=여기에-OpenAI-API-키

# --- 무료 스톡 사진 검색 (콘텐츠 관리 탭 - "스톡 사진 검색") ---
# 1. https://www.pexels.com/api 가입 (완전 무료, 카드 등록 불필요)
# 2. 가입 즉시 발급되는 API 키를 아래에 붙여넣기
PEXELS_API_KEY=여기에-Pexels-API-키

# --- 자동 파이프라인 (사람 없이 소싱→초안→2중3중 검수까지 자동 실행, /api/auto/run) ---
# 이 기능은 무료 외부 스케줄러(cron-job.org 등)가 아래 주소를 정해진 시간마다 호출하는 방식으로 동작해요:
#   GET https://<서비스주소>/api/auto/run?token=AUTO_RUN_SECRET값&keyword=검색할상품키워드&channel=인스타/틱톡
#
# 1. SUPABASE_SERVICE_ROLE_KEY: Supabase 대시보드 > Project Settings > API > "service_role" 키
#    (절대 프론트엔드나 다른 곳에 노출하지 마세요 - DB 전체 권한을 가진 비밀 키예요)
SUPABASE_SERVICE_ROLE_KEY=여기에-Supabase-service-role-키
#
# 2. AUTO_TARGET_USER_ID: Supabase 대시보드 > Authentication > Users에서 본인 계정의 UUID를 복사
#    (자동 생성된 초안을 이 계정 소유로 저장하기 위함)
AUTO_TARGET_USER_ID=여기에-본인-Supabase-user-UUID
#
# 3. AUTO_RUN_SECRET: Render 배포 시 자동으로 랜덤 값이 생성돼요 (render.yaml 참고).
#    Render 대시보드 > Environment 탭에서 생성된 값을 확인해서 스케줄러 URL의 token= 자리에 넣으세요.
#    로컬에서 테스트하려면 아래에 아무 문자열이나 직접 넣어도 돼요.
AUTO_RUN_SECRET=여기에-임의의-비밀문자열

# --- 인스타그램 자동 입력 (진희님 컴퓨터에서만 동작, Render 배포 서버에서는 동작 안 함) ---
# 진짜 인스타그램 API가 아니라, 이 컴퓨터의 실제 크롬 브라우저를 자동으로 조작하는 방식이에요
# (메타 앱 심사·비즈니스 인증 필요 없음). 사진·캡션까지 자동으로 채우고, 마지막 "공유" 버튼만
# 직접 눌러야 해요 (완전 자동 게시 아님 - 안전을 위해 일부러 이렇게 만들었어요).
# 로그인 정보는 ~/.anyone-instagram-profile 폴더에 저장되어 다음부터 다시 로그인 안 해도 돼요.
ENABLE_LOCAL_BROWSER_AUTOMATION=true

# 댓글 자동 확인 기능(CS 링크 관리 페이지)이 어느 계정의 게시물을 훑어볼지 지정 - 안 넣으면 anyone.living 사용
INSTAGRAM_HANDLE=anyone.living

# 사용법:
# 1. 이 파일을 .env 로 복사 (cp .env.example .env)
# 2. 위 값들을 실제 값으로 채우기 (Supabase는 이미 하셨다면 그대로, Claude API 키만 있으면 우선 시작 가능)
# 3. .env 는 절대 git에 커밋하지 않기 (.gitignore에 이미 포함됨)
