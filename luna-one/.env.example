# 글 생성용 (anyone-dashboard와 동일한 Claude 키를 써도 됨)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 카드뉴스 이미지 생성용 (버튼을 눌렀을 때만 호출됨, 없어도 텍스트 생성은 정상 작동)
OPENAI_API_KEY=

# 카드뉴스용 무료 스톡 사진 검색 (Pexels, 무료 - anyone-dashboard와 동일한 키를 써도 됨)
PEXELS_API_KEY=

# 네이버 블로그 자동 채우기 (로컬 실행 전용 - Render 등 서버에서는 화면이 없어서 작동 안 함).
# true로 켜면 실제 크롬 창이 뜨고, 최초 1회 직접 로그인해야 함. 로그인/발행 버튼은 항상 사람이 누름.
ENABLE_LOCAL_BROWSER_AUTOMATION=false

PORT=4174
